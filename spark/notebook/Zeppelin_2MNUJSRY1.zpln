    {
      "text": "%spark.pyspark\n\nfrom pyspark.sql.functions import col\n\nwdi_canada_df = (\n    spark.table(\"wdi_csv_parquet\")\n    .filter(\n        (col(\"indicatorCode\") == \"NY.GDP.MKTP.KD.ZG\") &\n        (col(\"countryName\") == \"Canada\")\n    )\n    .select(\n        col(\"year\").cast(\"string\").alias(\"year\"),\n        col(\"IndicatorValue\").cast(\"double\").alias(\"GDP\")\n    )\n    .orderBy(\"year\")\n)\n\nwdi_canada_df.printSchema()\nwdi_canada_df.show()\n\nz.show(wdi_canada_df)",
      "user": "anonymous",
