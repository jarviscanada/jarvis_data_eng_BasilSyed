    {
      "text": "%spark.pyspark\n\nfrom pyspark.sql.functions import col, max as spark_max\n\nt1 = (\n    spark.table(\"wdi_csv_parquet\")\n    .filter(\n        (col(\"indicatorcode\") == \"NY.GDP.MKTP.KD.ZG\") &\n        (col(\"indicatorvalue\") != 0)\n    )\n    .groupBy(\"countryname\")\n    .agg(spark_max(\"indicatorvalue\").alias(\"ind\"))\n)\n\nresult_df = (\n    t1.alias(\"t1\")\n    .join(\n        spark.table(\"wdi_csv_parquet\").alias(\"w\"),\n        (col(\"t1.ind\") == col(\"w.indicatorvalue\")) &\n        (col(\"t1.countryname\") == col(\"w.countryname\")),\n        \"inner\"\n    )\n    .select(\n        col(\"w.indicatorvalue\").alias(\"value\"),\n        col(\"w.year\").alias(\"year\"),\n        col(\"w.countryname\").alias(\"country\")\n    )\n)\n\nz.show(result_df)\n",
      "user": "anonymous",
      "dateUpdated": "2026-04-01T15:13:25+0000",
